NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# get the token at steam.com
STEAM_API_KEY=
STEAM_ID=

# get the token at github.com
GITHUB_TOKEN=

#
# get recaptcha, google and youtube credentials
# at cloud.google.com
#
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# get your api key at wakatime.com
WAKATIME_API_KEY=
# get your stream id at analytics.google.com
NEXT_PUBLIC_GOOGLE_ANALYTICS_STREAM_ID=
# get your publisher id at adsense.google.com
NEXT_PUBLIC_GOOGLE_ADS_PUBLISHER_ID=
# get your norton site verification at safeweb.norton.com
NEXT_PUBLIC_NORTON_SAFEWEB_SITE_VERIFICATION=

# resend.com
RESEND_API_KEY=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_FROM_EMAIL="Melvin Jones Repol <me@melvinjonesrepol.com>"
NEWSLETTER_FROM_EMAIL="Melvin Jones Repol <me@melvinjonesrepol.com>"
CONTACT_RECEIVER_EMAIL=support@melvinjonesrepol.com
REPORT_RECEIVER_EMAIL=support@melvinjonesrepol.com

# console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# the time to wait before deduping newsletter signups (in seconds)
NEWSLETTER_DEDUPE_TTL_SECONDS=31536000 # 365 days
